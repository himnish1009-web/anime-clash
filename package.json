{
  "name": "anime-clash",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint src server tests",
    "test": "node tests/sim.test.mjs",
    "test:dom": "node --import ./tests/dom-setup.mjs --experimental-loader ./tests/jsx-loader.mjs tests/dom.test.jsx",
    "test:online": "node tests/online.test.mjs",
    "test:browser": "node tests/browser-check.mjs",
    "test:all": "npm run test && npm run test:dom && npm run test:online",
    "server": "node server/server.js",
    "start": "node server/server.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.0",
    "vite": "^8.3.0"
  },
  "description": "Anime Clash \u2014 a browser anime fighting game (React + Tailwind + a hand-written canvas engine) with local versus, CPU and online PvP."
}